<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="AuditController"
        prefHeight="700.0" prefWidth="1000.0">

    <children>

        <Label text="Malabe Tuk-Tuk &amp; Three-Wheeler Spares Depot"
               layoutX="20" layoutY="10"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox layoutX="20" layoutY="45" spacing="10">
            <children>
                <Button text="Inventory"
                        onAction="#goToInventory"/>
                <Button text="Low Stock"
                        onAction="#goToLowStock"/>
                <Button text="Dealers"
                        onAction="#goToDealers"/>
                <Button text="Point of Sale"
                        onAction="#goToPOS"/>
                <Button text="Audit Log"
                        style="-fx-background-color: #2196F3;
                           -fx-text-fill: white;"
                        onAction="#goToAudit"/>
            </children>
        </HBox>

        <Label text="Audit Log"
               layoutX="20" layoutY="90"
               style="-fx-font-size: 16px;
                   -fx-font-weight: bold;"/>

        <Button text="Refresh Log"
                layoutX="20" layoutY="120"
                style="-fx-background-color: #2196F3;
                   -fx-text-fill: white;"
                onAction="#refreshLog"/>

        <TextArea fx:id="logArea"
                  layoutX="20" layoutY="160"
                  prefWidth="960" prefHeight="480"
                  editable="false"
                  style="-fx-font-family: monospace;"/>

    </children>
</AnchorPane>