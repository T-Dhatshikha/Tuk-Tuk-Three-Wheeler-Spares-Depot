<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="LowStockController"
        prefHeight="700.0" prefWidth="1000.0">

    <children>

        <Label text="Malabe Tuk-Tuk &amp; Three-Wheeler Spares Depot"
               layoutX="20" layoutY="10"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox layoutX="20" layoutY="45" spacing="10">
            <children>
                <Button text="Inventory"
                        onAction="#goToInventory"/>
                <Button text="Low Stock"
                        style="-fx-background-color: #2196F3;
                           -fx-text-fill: white;"
                        onAction="#goToLowStock"/>
                <Button text="Dealers"
                        onAction="#goToDealers"/>
                <Button text="Point of Sale"
                        onAction="#goToPOS"/>
                <Button text="Audit Log"
                        onAction="#goToAudit"/>
            </children>
        </HBox>

        <Label text="Low Stock Monitor"
               layoutX="20" layoutY="90"
               style="-fx-font-size: 16px;
                   -fx-font-weight: bold;"/>

        <HBox layoutX="20" layoutY="120" spacing="10">
            <children>
                <Label text="Threshold:"/>
                <TextField fx:id="thresholdField"
                           text="10" prefWidth="80"/>
                <Button text="Set Threshold"
                        style="-fx-background-color: #2196F3;
                           -fx-text-fill: white;"
                        onAction="#setThreshold"/>
                <Button text="Refresh"
                        style="-fx-background-color: #4CAF50;
                           -fx-text-fill: white;"
                        onAction="#refreshList"/>
                <Label fx:id="thresholdLabel"
                       text="Current threshold: 10"/>
            </children>
        </HBox>

        <TableView fx:id="lowStockTable"
                   layoutX="20" layoutY="160"
                   prefWidth="960" prefHeight="400">
            <columns>
                <TableColumn fx:id="codeCol"
                             text="Code" prefWidth="80"/>
                <TableColumn fx:id="nameCol"
                             text="Name" prefWidth="220"/>
                <TableColumn fx:id="qtyCol"
                             text="Quantity" prefWidth="100"/>
                <TableColumn fx:id="catCol"
                             text="Category" prefWidth="120"/>
                <TableColumn fx:id="priceCol"
                             text="Price" prefWidth="120"/>
            </columns>
        </TableView>

        <Label fx:id="summaryLabel"
               layoutX="20" layoutY="575"
               style="-fx-font-size: 14px;
                   -fx-font-weight: bold;"/>

    </children>
</AnchorPane>